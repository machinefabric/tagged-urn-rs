[dependencies]
regex = "1.0"
serde_json = "1.0"

# The runtime the code generated from ../formal runs on (see ../lungo.toml). The
# generated code is lungo's of the same version, so the runtime is pinned exactly.
[dependencies.lungo]
{%- if env.MFR_LIBS == "working" %}
# MFR_LIBS was "working" when this was rendered: the working copy in this
# workspace rather than a published release. Re-render without it before
# committing or releasing — a path resolves on this machine only.
path = "{{ projects.lungo_rs.path_from_here }}/crates/lungo"
{%- elif env.MFR_LIBS == "channel" %}
# MFR_LIBS "channel": the release fetched under the build root, in place of the public one.
version = "={{ projects.lungo_rs.version }}"
{%- else %}
version = "={{ projects.lungo_rs.latest_remote_version }}"
{%- endif %}

[dependencies.serde]
features = ["derive"]
version = "1.0"

[dev-dependencies]
serde_json = "1.0"

[package]
authors = ["https://github.com/machinefabric"]
description = "Tagged URN - Flat tag-based identifier system"
edition = "2021"
rust-version = "1.89"
license = "MIT"
name = "tagged-urn"
version = "{{ project.version }}"

{%- if env.MFR_LIBS == "channel" %}

# MFR_LIBS "channel": the libraries the graph pins by version, from the releases fetched under
# the build root, in place of crates.io.
[patch.crates-io]
lungo = { path = "{{ build.root_from_here }}/libraries/lungo/{{ projects.lungo_rs.version }}/lungo-{{ projects.lungo_rs.version }}" }
lungo-runtime = { path = "{{ build.root_from_here }}/libraries/lungo/{{ projects.lungo_rs.version }}/lungo-runtime-{{ projects.lungo_rs.version }}" }
{%- endif %}
